  "scripts": {
    "proposal_workflow.R": "# Proposal Workflow\n# Everyday Example 1: Proposal drafting & peer review\n\ndraft_v1 <- 'Intro: First draft of proposal'\ndraft_v2 <- paste(draft_v1, 'Methodology: Mixed-methods')\n\nfeedback <- c(rev1 = 'Add context', rev2 = 'Solid')\nfinal_text <- paste(draft_v2, paste(feedback, collapse='; '))\n\npdf('proposal.pdf')\nplot.new()\ntext(0.5, 0.5, final_text)\ndev.off()",

    "coffee_tracker.R": "# Weekly Coffee Tracker\n# Everyday Example 2: Calculating espresso expenses\n\ndaily_cups <- c(Mon=2, Tue=3, Wed=2, Thu=4, Fri=1)\nprice_per_cup <- 4.50\n\nweekly_spent <- sum(daily_cups) * price_per_cup\nwrite.csv(weekly_spent, 'coffee_summary.csv')",

    "weather_analysis.R": "# Weather Analysis\n# Everyday Example 3: Tracking temperature & hot days\n\ntemps <- c(72, 68, 75, 80, 77, 65, 70)\ndays  <- c('Mon','Tue','Wed','Thu','Fri','Sat','Sun')\n\navg_temp <- mean(temps)\nhot_days <- days[temps > avg_temp]\n\npdf('weather_chart.pdf')\nbarplot(temps, names.arg = days, col = 'steelblue')\ndev.off()",

    "recipe_scaling.R": "# Recipe Scaling\n# Everyday Example 4: Scaling cookie ingredients\n\nrecipe <- data.frame(ing = c('flour','sugar','eggs'), amt = c(2, 1, 3))\nscale_factor <- 3\n\nscaled <- recipe\nscaled$amt <- recipe$amt * scale_factor\nwrite.csv(scaled, 'party_recipe.csv')",

    "student_grades.R": "# Student Grading\n# Everyday Example 5: Class average & letter grades\n\nstudents <- c('Alice','Bob','Carol','Dan')\nscores   <- c(92, 85, 78, 96)\n\ngrades <- data.frame(name = students, score = scores)\ngrades$letter <- ifelse(grades$score >= 90, 'A', 'B')\nclass_avg <- mean(grades$score)"
  }
}
